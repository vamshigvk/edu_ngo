# Copy to `.env` to override Compose defaults. All values are optional —
# docker-compose.yml ships with working defaults for local development.

# Postgres credentials (used by the db service and the backend connection string)
POSTGRES_USER=ffg
POSTGRES_PASSWORD=ffg_password
POSTGRES_DB=ffg

# Backend secrets / config
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=*

# SMTP delivery for application decision emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Host ports (change these if a port is already in use on your machine)
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
