# Copy this file to `.env` and adjust values.
# Application
APP_NAME="FFG Mentorship API"
APP_ENV=development
DEBUG=true

# Database
# SQLite (default, dev):
DATABASE_URL="sqlite+aiosqlite:///./ffg.db"
# PostgreSQL (production) — swap the line above for:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/ffg"

# Security / JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS="*"
